{
  "name": "criterium",
  "private": true,
  "version": "0.3.0-beta.5",
  "type": "module",
  "description": "Criterium: protocolos odontológicos con evidencia trazable, casos clínicos y revisión por pares.",
  "scripts": {
    "video:clinica": "node scripts/video-clinica.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "emuladores": "firebase emulators:start --only auth,firestore",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-criterium \"node --test --test-concurrency=1 tests-reglas/piloto.reglas.mjs tests-reglas/chat.reglas.mjs tests-reglas/clinica.reglas.mjs\"",
    "ios": "vite build && cap sync ios && cap open ios",
    "ios:sync": "vite build && cap sync ios",
    "deploy": "vite build && firebase deploy --only hosting",
    "pdfs": "node scripts/pdfs.mjs",
    "protocolos:subir": "node scripts/subir-protocolos.mjs",
    "materia:subir": "node scripts/subir-materia.mjs",
    "materia:inventario": "node scripts/materia-inventario.mjs",
    "materia:validar": "node scripts/validar-materia.mjs",
    "materia:noche": "caffeinate -i node scripts/materia-noche.mjs",
    "voces": "node scripts/voces.mjs",
    "catalogo": "node scripts/catalogo-anim.mjs",
    "dev:creativa": "vite --mode creativa",
    "build:creativa": "vite build --mode creativa --outDir dist-creativa",
    "deploy:creativa": "vite build --mode creativa --outDir dist-creativa && firebase hosting:channel:deploy creativa --expires 30d --config firebase.creativa.json"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "firebase": "^12.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "puppeteer-core": "^23.11.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  }
}
