rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de casos. Los permisos siguen al documento del caso en Firestore.
    match /casos/{casoId}/fotos/{fotoId} {
      function rutaCaso() { return /databases/(default)/documents/casos/$(casoId); }
      function casoExiste() { return firestore.exists(rutaCaso()); }
      function caso() { return firestore.get(rutaCaso()).data; }
      function esAutor() { return caso().autorUid == request.auth.uid; }

      // Leer: el autor siempre; otros con sesión, solo si el caso no es borrador.
      allow read: if request.auth != null && casoExiste()
        && (esAutor() || caso().estado != 'borrador');

      // Subir o reemplazar: solo el autor. Si el caso todavía no existe
      // (la migración sube las fotos antes de crear el caso) se permite.
      // Solo imágenes de hasta 5 MB.
      allow write: if request.auth != null
        && (!casoExiste() || esAutor())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Borrar: solo el autor.
      allow delete: if request.auth != null && (!casoExiste() || esAutor());
    }
  }
}
