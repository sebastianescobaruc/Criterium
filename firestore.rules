rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Modo piloto START MEDUC (config/piloto) ──
    // autenticado(): hay sesión. conSesion(): hay sesión y la cuenta está habilitada: durante el piloto, un correo de un
    // dominio por invitación (uc.cl) sin invitación usada no recibe nada (Firebase sin Blaze no puede impedir crear la cuenta).
    function autenticado() { return request.auth != null; }
    function conSesion() { return autenticado() && habilitado(); }
    function soy(uid) { return conSesion() && request.auth.uid == uid; }
    function rutaPiloto() { return /databases/$(database)/documents/config/piloto; }
    function hayPiloto() { return exists(rutaPiloto()); }
    function cfgPiloto() { return get(rutaPiloto()).data; }
    function rutaParticipante() { return /databases/$(database)/documents/participantes/$(request.auth.uid); }
    function esParticipante() { return autenticado() && exists(rutaParticipante()); }
    function participante() { return get(rutaParticipante()).data; }
    // Se abre todo con el botón «Abrir todo» o al llegar la fecha de apertura. Sin piloto configurado, todo está abierto.
    function abierto() { return !hayPiloto() || cfgPiloto().get('abierto', false) == true || request.time >= cfgPiloto().apertura; }
    function correoPorInvitacion() {
      let correo = request.auth.token.get('email', '').lower();
      return hayPiloto() && cfgPiloto().get('registroUCInvitacion', false) == true
        && correo.split('@').size() == 2 && correo.split('@')[1] in cfgPiloto().get('dominiosInvitacion', []);
    }
    function habilitado() {
      return !correoPorInvitacion() || esParticipante()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }
    // Participantes del piloto: sin la red ni los módulos nuevos hasta la apertura (la intervención son solo los protocolos)
    function modulosBloqueados() { return esParticipante() && !abierto() && cfgPiloto().get('modulosNuevos', false) != true; }
    function comunidad() { return conSesion() && !modulosBloqueados(); }
    // Protocolos: el grupo habitual no ve ninguno hasta la apertura; el grupo criterium, solo los 5 del estudio
    function puedeVerProtocolo(p) {
      return esAdmin() || (conSesion() && p.publicado == true
        && (!esParticipante() || abierto() || (participante().grupo == 'criterium' && p.estudio == true)));
    }
    function congelado(p) { return hayPiloto() && cfgPiloto().get('congelados', false) == true && p.estudio == true; }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Equipo Criterium: existe /admins/{uid}. Solo se agrega a mano desde la consola. Es el filtro de publicación.
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Docente verificado: existe /docentes/{uid}. Solo se agrega a mano desde la consola.
    // El portal docente (Mis casos, Revisión de casos, Asistente) y todo lo de casos exige este rol.
    function esDocente() {
      return conSesion() && exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }

    // Revisor de casos de Criterium Red: docente verificado o equipo Criterium
    function esRevisor() { return esDocente() || esAdmin(); }

    // Lista de docentes. Cada uno lee solo su propio documento (para saber si es docente); nadie la escribe desde la app.
    // Cualquiera con sesión la lee: el estudiante elige de esta lista al docente que lo evalúa.
    match /docentes/{uid} {
      allow read: if conSesion();
      allow write: if false;
    }

    // Agenda: cada cita es de un estudiante y la evalúa un docente verificado.
    // Del paciente solo van las iniciales (2 a 4 letras mayúsculas) y la pieza.
    match /citas/{citaId} {
      function soyEstudiante() { return soy(resource.data.estudianteUid); }
      function soyDocente() { return soy(resource.data.docenteUid) && esDocente(); }
      function citaValida(d) {
        return d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.hora is string && d.hora.matches('^[0-9]{2}:[0-9]{2}$')
          && d.paciente is string && d.paciente.matches('^[A-ZÁÉÍÓÚÑ]{2,4}$')
          && d.protocoloId is string && d.box is string && d.duracion is int
          && d.docenteUid is string && d.docenteUid != request.auth.uid
          && exists(/databases/$(database)/documents/docentes/$(d.docenteUid));
      }
      function evaluacionValida(e) {
        return e.terminado == true && e.nota is number && e.nota >= 1 && e.nota <= 7
          && e.docente.uid == request.auth.uid && e.pasosBien is list && e.pasosTotal is int;
      }

      // Leer: el estudiante dueño y el docente que la evalúa. Nadie más.
      allow read: if soyEstudiante() || soyDocente();

      // Crear: a nombre propio, agendada y sin evaluación.
      allow create: if conSesion()
        && request.resource.data.estudianteUid == request.auth.uid
        && request.resource.data.estado == 'agendada'
        && !('evaluacion' in request.resource.data)
        && citaValida(request.resource.data);

      // El estudiante la edita o la cancela mientras no esté evaluada.
      allow update: if soyEstudiante()
        && !('evaluacion' in resource.data) && !('evaluacion' in request.resource.data)
        && request.resource.data.estudianteUid == resource.data.estudianteUid
        && request.resource.data.estado in ['agendada', 'cancelada']
        && citaValida(request.resource.data);

      // El docente marca la T de terminado y pone la nota (1 a 7). Solo eso, y solo una vez.
      allow update: if soyDocente()
        && resource.data.estado == 'agendada'
        && cambia().hasOnly(['estado', 'evaluacion', 'actualizado'])
        && request.resource.data.estado == 'terminada'
        && evaluacionValida(request.resource.data.evaluacion);

      // Borrar: el estudiante, si no está evaluada.
      allow delete: if soyEstudiante() && !('evaluacion' in resource.data);
    }

    // Solicitudes de protocolos: cada uno crea y ve las suyas. El equipo de Criterium las gestiona desde la consola.
    // Comentarios en cada paso de un protocolo. Los lee cualquiera con sesión; cada uno crea a su nombre y borra los suyos.
    // Marcarse como docente exige serlo. Más adelante: correcciones de expertos y comentarios de docentes para sus estudiantes.
    match /comentarios/{id} {
      allow read: if comunidad();
      allow create: if comunidad()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.autor.uid == request.auth.uid
        && (request.resource.data.autor.docente == false || esDocente())
        && request.resource.data.protoId is string
        && request.resource.data.paso is int && request.resource.data.paso >= 0
        && request.resource.data.tipo in ['comentario', 'correccion']
        && request.resource.data.txt is string
        && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 1000;
      allow delete: if soy(resource.data.uid);
      allow update: if false;
    }

    match /solicitudes/{id} {
      allow create: if conSesion()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'recibida'
        && request.resource.data.procedimiento is string
        && request.resource.data.procedimiento.size() >= 5 && request.resource.data.procedimiento.size() <= 200
        && request.resource.data.get('detalle', '').size() <= 1000;
      allow read: if soy(resource.data.uid);
      allow update, delete: if false;
    }

    // Perfil de usuario: solo el dueño lee y escribe.
    match /usuarios/{uid} {
      allow read, write: if soy(uid);
    }

    // Lista de revisores verificados. Nadie la escribe desde la app.
    match /revisores/{uid} {
      allow read: if conSesion();
      allow write: if false;
    }

    // Casos clínicos: solo docentes. Los estudiantes no leen ni escriben casos.
    match /casos/{casoId} {
      function esAutor() { return soy(resource.data.autorUid); }

      // Leer: un docente autor siempre; otros docentes, solo casos que no son borrador.
      allow read: if esDocente()
        && (esAutor() || resource.data.estado != 'borrador');

      // Crear: un docente, a nombre propio, como borrador o enviado, sin revisiones.
      allow create: if esDocente()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.estado in ['borrador', 'enviado']
        && request.resource.data.get('revisiones', []).size() == 0;

      // Actualizar, camino 1: el autor edita su caso.
      // No puede tocar las revisiones, cambiar de dueño ni ponerse un veredicto.
      allow update: if esAutor() && esDocente()
        && request.resource.data.autorUid == resource.data.autorUid
        && request.resource.data.get('revisiones', []) == resource.data.get('revisiones', [])
        && (!('estado' in cambia())
            || request.resource.data.estado in ['borrador', 'enviado', 'cambios']);

      // Actualizar, camino 2: un docente firma una revisión (los revisores verificados también, si además son docentes).
      // No puede ser el autor (conflicto de interés), el caso tiene que estar en revisión,
      // agrega exactamente una revisión firmada con su uid y el veredicto coincide con el estado.
      allow update: if esDocente()
        && !esAutor()
        && resource.data.estado == 'enviado'
        && cambia().hasOnly(['revisiones', 'historial', 'estado', 'actualizado'])
        && revisionValida(
             request.resource.data.revisiones,
             resource.data.get('revisiones', []).size(),
             request.resource.data.estado);

      // Eliminar: solo el docente autor.
      allow delete: if esAutor() && esDocente();

      function revisionValida(revs, antes, estado) {
        return revs.size() == antes + 1
          && revisionFirmada(revs[antes], estado);
      }
      function revisionFirmada(r, estado) {
        return r.revisor.id == request.auth.uid
          && r.veredicto == estado
          && r.veredicto in ['aprobado', 'cambios', 'denegado']
          && puntaje(r.puntajes.pertinencia)
          && puntaje(r.puntajes.claridad)
          && puntaje(r.puntajes.evidencia)
          && r.justificacion is string && r.justificacion.size() >= 40
          // No se aprueba con evidencia bajo 3; pedir cambios o denegar exige un motivo.
          && (r.veredicto != 'aprobado' || r.puntajes.evidencia >= 3)
          && (r.veredicto == 'aprobado' || r.motivos.size() >= 1);
      }
      function puntaje(p) { return p is int && p >= 1 && p <= 5; }
    }

    // Feed de preguntas
    match /feed/{postId} {
      allow read: if comunidad();

      // Crear: nadie se pone la marca de verificado a sí mismo, y si trae autorUid tiene que ser el propio.
      // Directo al feed solo van publicaciones y preguntas; casos, borradores y protocolos entran por /pendientes
      // y los copia al feed el equipo Criterium al aprobarlos (con el mismo id).
      allow create: if (comunidad()
        && request.resource.data.autor.get('verificado', false) == false
        && request.resource.data.autor.get('oficial', false) == false
        && request.resource.data.get('autorUid', request.auth.uid) == request.auth.uid
        && request.resource.data.get('tipo', 'publicacion') in ['publicacion', 'pregunta', 'discusion', 'reel']
        && discusionValida()
        && reelValido())
        || esAdmin()
        || casoAprobado();

      // Discusión de un plan de tratamiento: de 2 a 4 planes, sin votos al crearla
      function discusionValida() {
        return request.resource.data.get('tipo', 'publicacion') != 'discusion'
          || (request.resource.data.opciones is list && request.resource.data.opciones.size() >= 2 && request.resource.data.opciones.size() <= 4
            && request.resource.data.get('votos', {}).size() == 0);
      }
      // Reel: un solo video vertical, de los que el equipo aloja en Criterium (/reels/…mp4)
      function reelValido() {
        return request.resource.data.get('tipo', 'publicacion') != 'reel'
          || (request.resource.data.adjuntos is list && request.resource.data.adjuntos.size() == 1
            && request.resource.data.adjuntos[0].tipo == 'video'
            && request.resource.data.adjuntos[0].url.matches('/reels/[a-z0-9-]+[.]mp4'));
      }
      // Un revisor publica el caso que aprobó: mismo id y mismo autor que en /pendientes, y nunca el suyo
      function casoAprobado() {
        return esRevisor()
          && request.resource.data.get('tipo', '') == 'caso' && request.resource.data.estado == 'publicado'
          && exists(/databases/$(database)/documents/pendientes/$(postId))
          && get(/databases/$(database)/documents/pendientes/$(postId)).data.autorUid == request.resource.data.autorUid
          && !soy(request.resource.data.autorUid);
      }

      // Actualizar: cualquiera con sesión puede dar "me pasó lo mismo" o agregar respuestas,
      // sin editar el texto ni borrar respuestas de otros.
      // En likedBy cada persona solo agrega o quita su propio uid.
      // Caso de la semana: un docente o el equipo destaca (o quita) una publicación, sin tocar nada más
      allow update: if esRevisor() && cambia().hasOnly(['destacado'])
        && (!('destacado' in request.resource.data) || request.resource.data.destacado.uid == request.auth.uid);
      allow update: if comunidad()
        && cambia().hasOnly(['likes', 'liked', 'likedBy', 'respuestas', 'votos'])
        && likeValido()
        && votosValidos()
        && request.resource.data.respuestas.size() >= resource.data.respuestas.size()
        && (resource.data.respuestas.size() == 0 || request.resource.data.respuestas[0:resource.data.respuestas.size()] == resource.data.respuestas)
        && respuestasNuevasValidas();

      // Borrar: el autor lo suyo, o el equipo Criterium
      allow delete: if soy(resource.data.get('autorUid', '')) || esAdmin();

      function likeValido() {
        let antes = resource.data.get('likedBy', []).toSet();
        let despues = request.resource.data.get('likedBy', []).toSet();
        return despues.difference(antes).hasOnly([request.auth.uid])
          && antes.difference(despues).hasOnly([request.auth.uid]);
      }
      // En una discusión cada persona vota (o retira) solo su propio voto, por un plan que exista
      function votosValidos() {
        let antes = resource.data.get('votos', {});
        let despues = request.resource.data.get('votos', {});
        return despues.diff(antes).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in despues)
            || (despues[request.auth.uid] is int && despues[request.auth.uid] >= 0 && despues[request.auth.uid] < resource.data.get('opciones', []).size()));
      }
      // La respuesta agregada no se marca como verificada y, si trae uid, es el propio.
      function respuestasNuevasValidas() {
        let n = resource.data.respuestas.size();
        return request.resource.data.respuestas.size() == n
          || (request.resource.data.respuestas.size() == n + 1
            && request.resource.data.respuestas[n].autor.get('verificado', false) == false
            && request.resource.data.respuestas[n].autor.get('uid', request.auth.uid) == request.auth.uid);
      }
    }

    // Perfil público: lo ve cualquiera con sesión; solo el dueño lo escribe. Nunca guarda el correo.
    match /perfiles/{uid} {
      allow read: if conSesion();
      allow delete: if soy(uid); // «Borrar mi cuenta»
      allow create, update: if soy(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'rol', 'institucion', 'area', 'descripcion', 'anio', 'intereses', 'temas', 'onboarding', 'invitadoPor', 'actualizado'])
        // Quién lo invitó (Invita a tu curso): un uid ajeno, nunca el propio
        && request.resource.data.get('invitadoPor', '') is string && request.resource.data.get('invitadoPor', '').size() <= 128
        && request.resource.data.get('invitadoPor', '') != uid
        && request.resource.data.get('intereses', []).size() <= 12
        && request.resource.data.get('temas', []).size() <= 12
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
        && request.resource.data.get('descripcion', '').size() <= 300;
    }

    // Equipo Criterium: cada uno lee solo el suyo (para saber si es admin); nadie lo escribe desde la app.
    match /admins/{uid} {
      allow read: if soy(uid);
      allow write: if false;
    }

    // Filtro de publicación: casos clínicos, borradores y protocolos esperan aquí antes del feed.
    // Los ven su autor y el equipo Criterium; el equipo aprueba (lo copia al feed) o rechaza con un motivo.
    match /pendientes/{id} {
      // El autor ve lo suyo; los revisores (docentes y equipo) ven la cola para revisar casos
      allow read: if comunidad() && (soy(resource.data.autorUid) || esRevisor());
      allow create: if comunidad()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.autor.get('verificado', false) == false
        && request.resource.data.autor.get('oficial', false) == false
        && request.resource.data.estado == 'revision'
        && request.resource.data.get('revisiones', []).size() == 0
        && request.resource.data.tipo in ['caso', 'borrador', 'protocolo']
        && request.resource.data.txt is string && request.resource.data.txt.size() <= 10000;
      // El equipo Criterium puede todo; un revisor (nunca el autor) agrega una revisión firmada a un caso en revisión;
      // el autor corrige y reenvía un caso al que le pidieron correcciones (sube la versión, no toca las revisiones)
      allow update: if esAdmin() || revisionDeCaso() || correccionDelAutor();
      allow delete: if (soy(resource.data.autorUid) && resource.data.estado != 'aprobado') || esAdmin();

      function revisionDeCaso() {
        let antes = resource.data.get('revisiones', []);
        let despues = request.resource.data.get('revisiones', []);
        return esRevisor() && !soy(resource.data.autorUid)
          && resource.data.tipo == 'caso' && resource.data.estado == 'revision'
          && cambia().hasOnly(['estado', 'revisiones', 'historial', 'actualizado'])
          && request.resource.data.estado in ['cambios', 'aprobado', 'rechazado']
          && despues.size() == antes.size() + 1
          && despues[0:antes.size()] == antes
          && despues[antes.size()].revisor.uid == request.auth.uid
          && despues[antes.size()].veredicto == request.resource.data.estado;
      }
      function correccionDelAutor() {
        return soy(resource.data.autorUid)
          && resource.data.estado == 'cambios' && request.resource.data.estado == 'revision'
          && cambia().hasOnly(['estado', 'titulo', 'txt', 'secciones', 'especialidad', 'procedimiento', 'diente', 'edad', 'pregunta', 'version', 'historial', 'actualizado'])
          && request.resource.data.version == resource.data.get('version', 1) + 1
          && request.resource.data.txt is string && request.resource.data.txt.size() <= 10000;
      }
    }


    // Seguimientos: el documento se llama {de}_{a}. Cada uno maneja solo a quién sigue.
    match /seguimientos/{segId} {
      allow read: if comunidad();
      allow create: if soy(request.resource.data.de)
        && segId == request.resource.data.de + '_' + request.resource.data.a
        && request.resource.data.de != request.resource.data.a
        && request.resource.data.keys().hasOnly(['de', 'a', 'fecha']);
      allow delete: if soy(resource.data.de);
      allow update: if false;
    }

    // Postulaciones a revisor
    match /postulaciones/{uid} {
      allow read, write: if soy(uid);
    }

    // Mensajes de contacto: se envían a nombre propio.
    match /mensajes/{msgId} {
      allow create: if conSesion() && request.resource.data.uid == request.auth.uid;
      allow read: if conSesion() && resource.data.uid == request.auth.uid;
    }
  
    // ═══ Criterium Red · Bloque 3 ═══
    // Desafío del día: lo publica un revisor (docente o equipo); cada persona responde una vez y lleva su racha
    match /desafios/{id} {
      allow read: if comunidad();
      allow create: if esRevisor() && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.opciones is list && request.resource.data.opciones.size() >= 2 && request.resource.data.opciones.size() <= 4
        && request.resource.data.correcta is int && request.resource.data.correcta >= 0 && request.resource.data.correcta < request.resource.data.opciones.size()
        && request.resource.data.fecha is string && request.resource.data.pregunta is string && request.resource.data.pregunta.size() <= 600;
      allow update, delete: if (esRevisor() && soy(resource.data.autor.uid)) || esAdmin();
      match /respuestas/{uid} {
        allow read: if comunidad();
        allow create: if soy(uid) && request.resource.data.uid == uid && request.resource.data.opcion is int;
        allow update, delete: if false;
      }
    }
    match /rachas/{uid} {
      allow read: if comunidad();
      allow write: if soy(uid) && request.resource.data.keys().hasOnly(['dias', 'mejor', 'ultimo'])
        && request.resource.data.dias is int && request.resource.data.mejor is int && request.resource.data.ultimo is string;
    }

    // Caso en 60 segundos: videos enlazados (YouTube o Vimeo) que sube un revisor; cada persona marca «Me sirve» solo con su uid
    match /videos/{id} {
      allow read: if comunidad();
      allow create: if esRevisor() && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.plataforma in ['youtube', 'vimeo'] && request.resource.data.vid is string && request.resource.data.vid.size() <= 40
        && request.resource.data.get('likedBy', []).size() == 0;
      allow update: if (comunidad() && cambia().hasOnly(['likedBy'])
          && request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()).hasOnly([request.auth.uid])
          && resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]))
        || (soy(resource.data.autor.uid) && !cambia().hasAny(['autor', 'likedBy']));
      allow delete: if soy(resource.data.autor.uid) || esAdmin();
    }

    // Ronda clínica en vivo: la crea un revisor; cualquiera con sesión se anota («Avísame») y escribe en el chat a su nombre
    match /rondas/{id} {
      allow read: if comunidad();
      allow create: if esRevisor() && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.inicio is string && request.resource.data.duracion is int
        && request.resource.data.asistentes.size() == 0 && request.resource.data.mensajes.size() == 0;
      allow update: if (soy(resource.data.autor.uid) && !cambia().hasAny(['autor']))
        || (comunidad() && cambia().hasOnly(['asistentes'])
          && request.resource.data.asistentes.toSet().difference(resource.data.asistentes.toSet()).hasOnly([request.auth.uid])
          && resource.data.asistentes.toSet().difference(request.resource.data.asistentes.toSet()).hasOnly([request.auth.uid]))
        || (comunidad() && cambia().hasOnly(['mensajes'])
          && request.resource.data.mensajes.size() == resource.data.mensajes.size() + 1
          && (resource.data.mensajes.size() == 0 || request.resource.data.mensajes[0:resource.data.mensajes.size()] == resource.data.mensajes)
          && request.resource.data.mensajes[resource.data.mensajes.size()].autor.uid == request.auth.uid
          && request.resource.data.mensajes[resource.data.mensajes.size()].txt.size() <= 500);
      allow delete: if soy(resource.data.autor.uid) || esAdmin();
    }

    // Espacios por curso: cualquiera con sesión ve los espacios y entra o sale solo a sí mismo;
    // las publicaciones del espacio las leen y escriben solo sus miembros
    match /grupos/{gid} {
      function miembro() { return comunidad() && request.auth.uid in get(/databases/$(database)/documents/grupos/$(gid)).data.miembros; }
      allow read: if comunidad();
      allow create: if comunidad() && request.resource.data.creador.uid == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid]
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 60;
      allow update: if (soy(resource.data.creador.uid) && !cambia().hasAny(['creador']))
        || (comunidad() && cambia().hasOnly(['miembros'])
          && request.resource.data.miembros.toSet().difference(resource.data.miembros.toSet()).hasOnly([request.auth.uid])
          && resource.data.miembros.toSet().difference(request.resource.data.miembros.toSet()).hasOnly([request.auth.uid]));
      allow delete: if soy(resource.data.creador.uid) || esAdmin();
      match /posts/{pid} {
        allow read: if miembro();
        allow create: if miembro() && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.autor.uid == request.auth.uid
          && request.resource.data.autor.get('verificado', false) == false
          && request.resource.data.tipo in ['publicacion', 'pregunta', 'discusion'];
        allow update: if miembro() && cambia().hasOnly(['likes', 'likedBy', 'respuestas', 'votos']);
        allow delete: if soy(resource.data.autorUid) || soy(get(/databases/$(database)/documents/grupos/$(gid)).data.creador.uid) || esAdmin();
      }
    }

    // Currículum del perfil: lo lee cualquiera con sesión; solo el dueño lo escribe (sin datos de contacto: lo cuida la app)
    match /curriculum/{uid} {
      allow read: if comunidad();
      allow delete: if soy(uid);
      allow create, update: if soy(uid)
        && request.resource.data.keys().hasOnly(['resumen', 'formacion', 'investigacion', 'clinica', 'voluntariados', 'ayudantias', 'cursos', 'premios', 'idiomas', 'habilidades', 'actualizado'])
        && request.resource.data.get('resumen', '') is string && request.resource.data.get('resumen', '').size() <= 1200
        && request.resource.data.get('formacion', []).size() <= 25 && request.resource.data.get('investigacion', []).size() <= 25
        && request.resource.data.get('clinica', []).size() <= 25 && request.resource.data.get('voluntariados', []).size() <= 25
        && request.resource.data.get('ayudantias', []).size() <= 25 && request.resource.data.get('cursos', []).size() <= 25
        && request.resource.data.get('premios', []).size() <= 25 && request.resource.data.get('idiomas', []).size() <= 25
        && request.resource.data.get('habilidades', []).size() <= 20;
    }

    // ── Universidad · Investigaciones: cada uno publica las suyas; «Me interesa» suma o quita solo el propio uid ──
    match /investigaciones/{id} {
      allow read: if comunidad();
      allow create: if comunidad() && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 5 && request.resource.data.titulo.size() <= 300
        && request.resource.data.likedBy.size() == 0;
      allow update: if (soy(resource.data.autorUid) && !cambia().hasAny(['autorUid', 'autor', 'likedBy']))
        || (comunidad() && cambia().hasOnly(['likedBy'])
          && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
          && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]));
      allow delete: if soy(resource.data.autorUid) || esAdmin();
    }
    // ── Universidad · Concursos: las convocatorias las publica el equipo Criterium ──
    match /convocatorias/{id} {
      allow read: if comunidad();
      allow create, update, delete: if esAdmin();
    }

    // ── Clínica: gestión clínica de una clínica (agenda, pacientes, ficha, presupuestos, pagos) ──
    // Solo sus miembros (clinicas/{cid}.miembros { uid: 'admin' | 'odontologo' | 'recepcion' }). Lo clínico (antecedentes,
    // odontograma, evoluciones, documentos) solo admin y odontólogo. Evoluciones, documentos, pagos y accesos no se editan
    // ni se borran. Las clínicas las crea el equipo Criterium. Mientras no haya revisión legal: solo clínicas de demostración.
    function rolEn(cid) { return get(/databases/$(database)/documents/clinicas/$(cid)).data.miembros.get(request.auth.uid, ''); }
    function miembroDe(cid) { return conSesion() && rolEn(cid) in ['admin', 'odontologo', 'recepcion']; }
    function clinicoDe(cid) { return conSesion() && rolEn(cid) in ['admin', 'odontologo']; }
    function adminDe(cid) { return conSesion() && rolEn(cid) == 'admin'; }
    match /clinicas/{cid} {
      allow get: if miembroDe(cid);
      allow list: if conSesion() && resource.data.miembros.get(request.auth.uid, '') in ['admin', 'odontologo', 'recepcion'];
      allow create: if esAdmin();
      allow update: if adminDe(cid) || esAdmin();
      allow delete: if false;
      match /pacientes/{pid} {
        allow read, create, update: if miembroDe(cid);
        allow delete: if false;
        match /clinico/{d} {
          allow read, write: if clinicoDe(cid);
        }
        match /evoluciones/{e} {
          allow read: if clinicoDe(cid);
          allow create: if clinicoDe(cid) && request.resource.data.profesional.uid == request.auth.uid && request.resource.data.firmada == true;
          allow update, delete: if false;
        }
        match /documentos/{d} {
          allow read: if clinicoDe(cid);
          allow create: if clinicoDe(cid) && request.resource.data.profesional.uid == request.auth.uid;
          allow update, delete: if false;
        }
      }
      match /citas/{id} {
        allow read, create, update: if miembroDe(cid);
        allow delete: if false;
      }
      match /presupuestos/{id} {
        allow read, update: if miembroDe(cid);
        allow create: if clinicoDe(cid);
        allow delete: if false;
      }
      match /pagos/{id} {
        allow read: if miembroDe(cid);
        allow create: if miembroDe(cid) && request.resource.data.registradoPor.uid == request.auth.uid && request.resource.data.monto is int && request.resource.data.monto > 0;
        allow update, delete: if false;
      }
      // Plan de tratamiento por fases: lo arman administración y odontólogos; recepción lo ve
      match /planes/{id} {
        allow read: if miembroDe(cid);
        allow create, update: if clinicoDe(cid);
        allow delete: if false;
      }
      // Órdenes de laboratorio: no se borran (se anulan cambiando el estado)
      match /laboratorio/{id} {
        allow read, create, update: if miembroDe(cid);
        allow delete: if false;
      }
      // Inventario: el stock cambia con movimientos registrados, que no se editan
      match /inventario/{id} {
        allow read, create, update: if miembroDe(cid);
        allow delete: if adminDe(cid);
        match /movimientos/{m} {
          allow read: if miembroDe(cid);
          allow create: if miembroDe(cid) && request.resource.data.por.uid == request.auth.uid && request.resource.data.cantidad is int && request.resource.data.cantidad > 0;
          allow update, delete: if false;
        }
      }
      // Esterilización: cada ciclo queda registrado a nombre de quien lo hizo y no se edita (trazabilidad)
      match /esterilizacion/{id} {
        allow read: if miembroDe(cid);
        allow create: if miembroDe(cid) && request.resource.data.responsable.uid == request.auth.uid;
        allow update, delete: if false;
      }
      // Gastos: los registra cualquier miembro y los ve la administración; no se editan
      match /gastos/{id} {
        allow read: if adminDe(cid);
        allow create: if miembroDe(cid) && request.resource.data.registradoPor.uid == request.auth.uid && request.resource.data.monto is int && request.resource.data.monto > 0;
        allow update, delete: if false;
      }
      // Cierre de caja diario: no se edita
      match /cierres/{id} {
        allow read: if miembroDe(cid);
        allow create: if miembroDe(cid) && request.resource.data.por.uid == request.auth.uid;
        allow update, delete: if false;
      }
      match /tareas/{id} {
        allow read, create, update, delete: if miembroDe(cid);
      }
      match /espera/{id} {
        allow read, create, update, delete: if miembroDe(cid);
      }
      match /accesos/{id} {
        allow read: if adminDe(cid);
        allow create: if miembroDe(cid) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Chat (Criterium Red) ──
    // chats/{a_b} (uids ordenados) con miembros [a, b], estado 'abierto' | 'solicitud' | 'rechazado', iniciadoPor,
    // ultimo { txt, autor, fecha }, leido { uid: fecha } y actualizado. Los mensajes van en chats/{id}/mensajes.
    // Con quien sigues o te sigue el chat nace abierto. Con cualquier otra persona se manda UN mensaje (una solicitud):
    // no se puede escribir más hasta que la otra persona responda (y el chat se abre) o lo elimina (queda rechazado).
    // bloqueos/{de_a}: quien bloquea deja de recibir y de poder enviar mensajes en ese chat.
    function relacion(a, b) {
      return exists(/databases/$(database)/documents/seguimientos/$(a + '_' + b))
        || exists(/databases/$(database)/documents/seguimientos/$(b + '_' + a));
    }
    function hayBloqueo(a, b) {
      return exists(/databases/$(database)/documents/bloqueos/$(a + '_' + b))
        || exists(/databases/$(database)/documents/bloqueos/$(b + '_' + a));
    }
    match /chats/{cid} {
      allow read: if comunidad() && request.auth.uid in resource.data.miembros;
      allow create: if comunidad()
        && request.resource.data.miembros is list && request.resource.data.miembros.size() == 2
        && request.auth.uid in request.resource.data.miembros
        && request.resource.data.miembros[0] < request.resource.data.miembros[1]
        && cid == request.resource.data.miembros[0] + '_' + request.resource.data.miembros[1]
        && request.resource.data.iniciadoPor == request.auth.uid
        && request.resource.data.keys().hasOnly(['miembros', 'estado', 'iniciadoPor', 'ultimo', 'leido', 'actualizado'])
        && !hayBloqueo(request.resource.data.miembros[0], request.resource.data.miembros[1])
        && (request.resource.data.estado == 'solicitud'
          || (request.resource.data.estado == 'abierto' && relacion(request.resource.data.miembros[0], request.resource.data.miembros[1])))
        && request.resource.data.ultimo.autor == request.auth.uid;
      allow update: if comunidad() && request.auth.uid in resource.data.miembros
        && request.resource.data.miembros == resource.data.miembros
        && request.resource.data.iniciadoPor == resource.data.iniciadoPor
        && cambia().hasOnly(['ultimo', 'leido', 'estado', 'actualizado'])
        // leído: cada uno marca solo lo suyo
        && (!('leido' in cambia()) || request.resource.data.leido.diff(resource.data.get('leido', {})).affectedKeys().hasOnly([request.auth.uid]))
        // último mensaje: solo en un chat abierto y a tu nombre
        && (!('ultimo' in cambia()) || (request.resource.data.estado == 'abierto' && request.resource.data.ultimo.autor == request.auth.uid))
        // estado: la solicitud la abre quien la recibe (respondiendo) o cualquiera si ya se siguen; solo quien la recibe la rechaza
        && (!('estado' in cambia())
          || (resource.data.estado == 'solicitud' && request.resource.data.estado == 'abierto'
            && (request.auth.uid != resource.data.iniciadoPor || relacion(resource.data.miembros[0], resource.data.miembros[1])))
          || (resource.data.estado == 'solicitud' && request.resource.data.estado == 'rechazado' && request.auth.uid != resource.data.iniciadoPor));
      allow delete: if false;
      match /mensajes/{mid} {
        function chatAhora() { return getAfter(/databases/$(database)/documents/chats/$(cid)).data; }
        allow read: if comunidad() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.miembros;
        allow create: if comunidad()
          && request.auth.uid in chatAhora().miembros
          && request.resource.data.autor == request.auth.uid
          && request.resource.data.keys().hasOnly(['autor', 'txt', 'fecha'])
          && request.resource.data.txt is string && request.resource.data.txt.size() >= 1 && request.resource.data.txt.size() <= 2000
          && !hayBloqueo(chatAhora().miembros[0], chatAhora().miembros[1])
          && (chatAhora().estado == 'abierto'
            // la solicitud: un solo mensaje, el que nace junto con el chat
            || (chatAhora().estado == 'solicitud' && chatAhora().iniciadoPor == request.auth.uid
              && !exists(/databases/$(database)/documents/chats/$(cid))));
        allow update, delete: if false;
      }
    }
    match /bloqueos/{bid} {
      allow get: if comunidad() && (request.auth.uid == resource.data.de || request.auth.uid == resource.data.a);
      allow list: if comunidad() && request.auth.uid == resource.data.de;
      allow create: if soy(request.resource.data.de) && bid == request.resource.data.de + '_' + request.resource.data.a
        && request.resource.data.de != request.resource.data.a && request.resource.data.keys().hasOnly(['de', 'a', 'fecha']);
      allow delete: if soy(resource.data.de);
    }

    // Materia (Criterium Red): clases de estudio en HTML, por ramo. Solo con sesión; las sube el equipo con npm run materia:subir.
    // materia/{ramo} lleva los datos del ramo y el índice de clases; materia/{ramo}/clases/{id} lleva el HTML.
    match /materia/{ramo} {
      allow read: if comunidad();
      allow write: if esAdmin();
      match /clases/{clase} {
        allow read: if comunidad();
        allow write: if esAdmin();
      }
    }

    // ═══ Modo piloto START MEDUC ═══
    // Configuración: la lee cualquiera (el registro la necesita antes de tener cuenta); solo el equipo la cambia.
    match /config/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Protocolos (fuera del código de la app): versión, fecha y huella SHA-256 de su contenido.
    // Las consultas tienen que filtrar por publicado (y por estudio, en el grupo criterium) para que la regla se cumpla.
    match /protocolos/{id} {
      allow read: if puedeVerProtocolo(resource.data);
      allow create: if esAdmin();
      // Durante el piloto los protocolos del estudio no se editan: el cambio va a versiones/ sin publicar
      allow update: if esAdmin() && !congelado(resource.data) && !congelado(request.resource.data);
      allow delete: if false;
      match /archivos/{archivo} {
        allow read: if puedeVerProtocolo(get(/databases/$(database)/documents/protocolos/$(id)).data);
        allow create: if esAdmin();
        allow update: if esAdmin() && !congelado(get(/databases/$(database)/documents/protocolos/$(id)).data);
        allow delete: if false;
      }
      match /versiones/{v} {
        allow read: if esAdmin();
        allow create: if esAdmin() && request.resource.data.publicado == false;
        allow update, delete: if false;
      }
    }

    // Participante: grupo y código seudónimo. Cada uno lee solo el suyo; el equipo asigna.
    // También se crea solo al usar una invitación, con el grupo y el código que trae la invitación.
    match /participantes/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if esAdmin() || (autenticado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['grupo', 'codigo', 'invitacion', 'fecha'])
        && invitacionMia(request.resource.data.invitacion)
        && request.resource.data.grupo == getAfter(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacion)).data.grupo
        && request.resource.data.codigo == getAfter(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacion)).data.participante);
      allow update, delete: if esAdmin();
      function invitacionMia(cod) {
        return cod is string && cod.size() <= 40
          && get(/databases/$(database)/documents/invitaciones/$(cod)).data.usada == false
          && getAfter(/databases/$(database)/documents/invitaciones/$(cod)).data.usadaPor == request.auth.uid;
      }
    }

    // Invitaciones con código individual: el equipo las entrega después de la firma del consentimiento.
    match /invitaciones/{cod} {
      // Se lee solo con el código exacto (8 caracteres al azar, sin listar): el registro lo valida antes de crear la cuenta
      allow get: if true;
      allow list, create, delete: if esAdmin();
      allow update: if esAdmin() || (autenticado() && resource.data.usada == false
        && cambia().hasOnly(['usada', 'usadaPor', 'fechaUso'])
        && request.resource.data.usada == true && request.resource.data.usadaPor == request.auth.uid
        && request.resource.data.fechaUso == request.time
        && existsAfter(/databases/$(database)/documents/participantes/$(request.auth.uid)));
    }

    // Qué persona hay detrás de cada código: solo el equipo.
    match /identidades/{codigo} {
      allow read, write: if esAdmin();
    }

    // Registro de uso del estudio: sin uid, nombre ni correo. Lo escribe el participante con su código; lo lee solo el equipo.
    match /eventos_uso/{id} {
      allow create: if esParticipante()
        && request.resource.data.keys().hasOnly(['codigo', 'sesion', 'tipo', 'protoId', 'fecha'])
        && request.resource.data.codigo == participante().codigo
        && request.resource.data.tipo in ['sesion_inicio', 'protocolo_abierto', 'nivel_2_abierto', 'nivel_3_abierto', 'pdf_descargado']
        && request.resource.data.fecha == request.time
        && request.resource.data.sesion is string && request.resource.data.sesion.size() <= 40
        && request.resource.data.protoId is string && request.resource.data.protoId.size() <= 80;
      allow read: if esAdmin();
      allow update, delete: if false;
    }
  }
}
