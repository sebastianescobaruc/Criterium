# Copia este archivo como .env y rellena con las credenciales de tu proyecto Firebase.
# Las puedes encontrar en Firebase Console → Configuración del proyecto → SDK web.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Voces naturales (Google Cloud Text-to-Speech). Va en .env.local, que no se sube a git.
# Sin prefijo VITE_ a propósito: solo la usa `npm run voces` en tu computador, nunca llega al navegador.
# Guía: docs/VOCES_GOOGLE_TTS.md
# GOOGLE_TTS_API_KEY=
# VOCES_TTS=es-US-Chirp3-HD-Aoede,es-US-Chirp3-HD-Charon

# Alejandra, la voz chilena (Azure AI Speech, es-CL). Va en .env.local, sin prefijo VITE_.
# Guía: docs/VOZ_ALEJANDRA_AZURE.md
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# ── Modo piloto START MEDUC ──
# Los interruptores reales viven en Firestore (config/piloto) y se cambian en «Piloto START» (equipo Criterium).
# Estos valores solo crean config/piloto la primera vez que corres `npm run protocolos:subir` (van en .env.local):
# PILOTO_APERTURA=2027-11-01
# REGISTRO_UC_POR_INVITACION=false   # true al empezar el piloto (jun 2027)
# MODULOS_NUEVOS_EN_PILOTO=false
# PROTOCOLOS_CONGELADOS=false        # true al empezar el piloto (después del juicio de expertos)
# DOMINIOS_INVITACION=uc.cl
# Cuenta del equipo para `npm run protocolos:subir` (si no están, el script las pide):
# CRITERIUM_ADMIN_EMAIL=
# CRITERIUM_ADMIN_PASSWORD=
# Para la interfaz (valores por defecto mientras no exista config/piloto):
# VITE_PILOTO_APERTURA=2027-11-01
# Trabajar sin conexión con los protocolos de src/data.js dentro del código (solo en tu computador, nunca al publicar):
# VITE_PROTOCOLOS_LOCALES=true
# Usar los emuladores locales de Firebase (npm run emuladores):
# VITE_EMULADORES=true
